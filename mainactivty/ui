// HALAMAN 2: MEMBERSHIP
@Composable
fun MembershipScreen(
    vm: CafeViewModel,
    onBack: () -> Unit
) {

    var name by remember { mutableStateOf("") }
    var email by remember { mutableStateOf("") }
    var phone by remember { mutableStateOf("") }
    var message by remember { mutableStateOf("") }

    val member = vm.member

    val scrollState = rememberScrollState()
    val coroutineScope = rememberCoroutineScope()

    val emailRequester = remember {
        BringIntoViewRequester()
    }

    val phoneRequester = remember {
        BringIntoViewRequester()
    }
    Column(
        modifier = Modifier
            .fillMaxSize()
            .imePadding()
            .padding(18.dp)
    ) {

        CafeHeader()

        Text(
            "← Kembali ke menu",
            color = Green,
            fontWeight = FontWeight.SemiBold,
            modifier = Modifier
                .clickable { onBack() }
                .padding(vertical = 10.dp)
        )

        Column(
            modifier = Modifier
                .fillMaxWidth()
                .weight(1f)
                .background(
                    Sage,
                    RoundedCornerShape(24.dp)
                )
                .padding(18.dp)
                .verticalScroll(scrollState)

        ) {

            Text(
                "LEBIH BANYAK SAYANG ♡",
                color = Orange,
                fontSize = 11.sp,
                fontWeight = FontWeight.Bold
            )

            Spacer(Modifier.height(10.dp))

            Text(
                "Gabung membership",
                fontSize = 26.sp,
                fontWeight = FontWeight.Bold,
                color = Brown
            )

            Spacer(Modifier.height(12.dp))

            Text(
                "Membership memberi customer benefit lebih: diskon otomatis untuk pesanan yang memenuhi syarat. Tanpa membership, pesanan tidak mendapat diskon.",
                fontSize = 13.sp,
                color = Green
            )

            Spacer(Modifier.height(16.dp))

            Column(
                modifier = Modifier
                    .fillMaxWidth()
                    .background(
                        Color.White,
                        RoundedCornerShape(16.dp)
                    )
                    .padding(14.dp)
            ) {
                Text(
                    "Subtotal di atas Rp100.000: 4% · di atas Rp200.000: 6% · di atas Rp300.000: 7% · di atas Rp600.000: 10%. Hanya satu diskon tertinggi yang berlaku.",
                    fontSize = 12.sp,
                    color = Muted
                )
            }

            Spacer(Modifier.height(20.dp))

            if (member != null) {

                Text(
                    "Membership aktif ✓",
                    color = Green,
                    fontWeight = FontWeight.Bold,
                    fontSize = 18.sp
                )

                Spacer(Modifier.height(10.dp))

                Text("Nama: ${member.name}")
                Text("Email: ${member.email}")
                Text("Nomor HP: ${member.phone}")

                Spacer(Modifier.height(12.dp))

                Text(
                    "Diskon otomatis berlaku untuk pesananmu selama aplikasi berjalan.",
                    color = Green,
                    fontSize = 13.sp
                )

            } else {

                Text(
                    "Nama lengkap *",
                    fontWeight = FontWeight.SemiBold,
                    color = Brown
                )

                OutlinedTextField(
                    value = name,
                    onValueChange = { name = it },
                    modifier = Modifier.fillMaxWidth(),
                    placeholder = { Text("Nama kamu") },
                    singleLine = true,
                    shape = RoundedCornerShape(12.dp),
                    colors = cafeFieldColors()
                )

                Spacer(Modifier.height(12.dp))

                Text(
                    "Email *",
                    fontWeight = FontWeight.SemiBold,
                    color = Brown
                )

                OutlinedTextField(
                    value = email,
                    onValueChange = { email = it },
                    modifier = Modifier
                        .fillMaxWidth()
                        .bringIntoViewRequester(emailRequester)
                        .onFocusChanged { focusState ->
                            if (focusState.isFocused) {
                                coroutineScope.launch {
                                    emailRequester.bringIntoView()
                                }
                            }
                        },
                    placeholder = {
                        Text("nama@email.com")
                    },
                    singleLine = true,
                    keyboardOptions = KeyboardOptions(
                        keyboardType = KeyboardType.Email
                    ),
                    shape = RoundedCornerShape(12.dp),
                    colors = cafeFieldColors()
                )

                Spacer(Modifier.height(12.dp))

                Text(
                    "Nomor HP *",
                    fontWeight = FontWeight.SemiBold,
                    color = Brown
                )

                OutlinedTextField(
                    value = phone,
                    onValueChange = { phone = it },
                    modifier = Modifier
                        .fillMaxWidth()
                        .bringIntoViewRequester(phoneRequester)
                        .onFocusChanged { focusState ->
                            if (focusState.isFocused) {
                                coroutineScope.launch {
                                    phoneRequester.bringIntoView()
                                }
                            }
                        },
                    placeholder = {
                        Text("08xxxxxxxxxx")
                    },
                    singleLine = true,
                    keyboardOptions = KeyboardOptions(
                        keyboardType = KeyboardType.Phone
                    ),
                    shape = RoundedCornerShape(12.dp),
                    colors = cafeFieldColors()
                )

                Spacer(Modifier.height(16.dp))

                Button(
                    onClick = {
                        when {
                            name.isBlank() ||
                                    email.isBlank() ||
                                    phone.isBlank() -> {
                                message = "Semua kolom wajib diisi."
                            }

                            !android.util.Patterns.EMAIL_ADDRESS
                                .matcher(email.trim()).matches() -> {
                                message = "Masukkan email yang valid."
                            }

                            else -> {
                                vm.registerMember(
                                    name.trim(),
                                    email.trim(),
                                    phone.trim()
                                )
                                message = "Pendaftaran berhasil! Membership aktif."
                            }
                        }
                    },
                    modifier = Modifier.fillMaxWidth(),
                    colors = ButtonDefaults.buttonColors(
                        containerColor = Green
                    ),
                    shape = RoundedCornerShape(12.dp)
                ) {
                    Text("Daftar membership")
                }

                if (message.isNotEmpty()) {
                    Spacer(Modifier.height(12.dp))

                    Text(
                        message,
                        color = Green,
                        fontSize = 13.sp
                    )
                }

                Spacer(Modifier.height(12.dp))

                Text(
                    "Pendaftaran ini tidak menggunakan sandi atau login. Status aktif selama aplikasi berjalan.",
                    color = Muted,
                    fontSize = 11.sp
                )
            }
        }
    }
}

// HALAMAN 3: PESANAN
@Composable
fun OrderScreen(vm: CafeViewModel) {

    var customerName by remember { mutableStateOf("") }
    var notes by remember { mutableStateOf("") }
    var message by remember { mutableStateOf("") }

    // [BARU] State untuk menampilkan dialog "Pesanan sudah di proses"
    var showProcessedDialog by remember { mutableStateOf(false) }

    // Mengatur scroll ketika keyboard muncul
    val coroutineScope = rememberCoroutineScope()

    // Mengatur posisi kolom catatan
    val notesRequester = remember {
        BringIntoViewRequester()
    }

    val summary = vm.priceSummary

    Column(
        modifier = Modifier
            .fillMaxSize()
            .imePadding()
            .padding(horizontal = 18.dp)
    ) {

        CafeHeader()

        LazyColumn(
            modifier = Modifier.fillMaxSize(),
            verticalArrangement = Arrangement.spacedBy(12.dp)
        ) {

            item {
                Text(
                    "PESANANMU",
                    color = Orange,
                    fontSize = 11.sp,
                    fontWeight = FontWeight.Bold
                )

                Text(
                    "Yang bikin bahagia",
                    color = Brown,
                    fontSize = 26.sp,
                    fontWeight = FontWeight.Bold
                )

                Text(
                    "Periksa pilihanmu sebelum mengirim.",
                    color = Muted,
                    fontSize = 13.sp
                )
            }

            item {
                Card(
                    modifier = Modifier.fillMaxWidth(),
                    colors = CardDefaults.cardColors(
                        containerColor = Color.White
                    ),
                    shape = RoundedCornerShape(22.dp)
                ) {

                    Column(
                        modifier = Modifier.padding(16.dp)
                    ) {

                        if (vm.cartItems.isEmpty()) {
                            Text(
                                "Belum ada menu dipilih. Yuk, pilih favoritmu!",
                                modifier = Modifier
                                    .fillMaxWidth()
                                    .padding(vertical = 30.dp),
                                textAlign = TextAlign.Center,
                                color = Muted
                            )
                        } else {

                            vm.cartItems.forEach { (item, quantity) ->

                                Row(
                                    modifier = Modifier
                                        .fillMaxWidth()
                                        .padding(vertical = 8.dp),
                                    verticalAlignment = Alignment.CenterVertically
                                ) {

                                    Column(
                                        modifier = Modifier.weight(1f)
                                    ) {
                                        Text(
                                            item.name,
                                            fontWeight = FontWeight.Bold,
                                            color = Brown
                                        )

                                        Text(
                                            "${rupiah(item.price)} x $quantity",
                                            fontSize = 12.sp,
                                            color = Muted
                                        )
                                    }

                                    OutlinedButton(
                                        onClick = {
                                            vm.removeItem(item.id)
                                        },
                                        contentPadding = PaddingValues(8.dp)
                                    ) {
                                        Text("−")
                                    }

                                    Text(
                                        "$quantity",
                                        modifier = Modifier.padding(horizontal = 10.dp)
                                    )

                                    OutlinedButton(
                                        onClick = {
                                            vm.addItem(item.id)
                                        },
                                        contentPadding = PaddingValues(8.dp)
                                    ) {
                                        Text("+")
                                    }
                                }
                            }
                        }

                        HorizontalDivider(
                            modifier = Modifier.padding(vertical = 14.dp),
                            color = Color(0xFFE6E6D8)
                        )

                        PriceRow(
                            "Total sebelum diskon",
                            rupiah(summary.total)
                        )

                        PriceRow(
                            "Diskon membership",
                            "${summary.percent}%"
                        )

                        PriceRow(
                            "Nominal potongan",
                            rupiah(summary.discount)
                        )

                        HorizontalDivider(
                            modifier = Modifier.padding(vertical = 10.dp),
                            color = Color(0xFFE6E6D8)
                        )

                        PriceRow(
                            "Total akhir",
                            rupiah(summary.finalPrice),
                            bold = true
                        )
                    }
                }
            }

            item {
                Text(
                    if (vm.isMember)
                        "Membership aktif: diskon otomatis diterapkan."
                    else
                        "Belum menjadi member: tidak ada diskon.",
                    color = Muted,
                    fontSize = 12.sp
                )

                Spacer(Modifier.height(8.dp))

                Text(
                    "Nama pemesan *",
                    fontWeight = FontWeight.SemiBold,
                    color = Brown
                )

                OutlinedTextField(
                    value = customerName,
                    onValueChange = { customerName = it },
                    modifier = Modifier.fillMaxWidth(),
                    placeholder = { Text("Nama kamu") },
                    singleLine = true,
                    shape = RoundedCornerShape(12.dp),
                    colors = cafeFieldColors()
                )

                Spacer(Modifier.height(12.dp))

                Text(
                    "Catatan tambahan",
                    fontWeight = FontWeight.SemiBold,
                    color = Brown
                )

                OutlinedTextField(
                    value = notes,
                    onValueChange = { notes = it },
                    modifier = Modifier
                        .fillMaxWidth()
                        .height(100.dp)
                        .bringIntoViewRequester(notesRequester)
                        .onFocusChanged { focusState ->
                            if (focusState.isFocused) {
                                coroutineScope.launch {
                                    notesRequester.bringIntoView()
                                }
                            }
                        },
                    placeholder = {
                        Text("Tulis catatan pesanan...")
                    },
                    shape = RoundedCornerShape(12.dp),
                    colors = cafeFieldColors()
                )

                Spacer(Modifier.height(14.dp))

                Button(
                    onClick = {
                        message = when {
                            vm.cartItems.isEmpty() ->
                                "Pilih setidaknya satu menu."

                            customerName.isBlank() ->
                                "Nama pemesan wajib diisi."

                            else -> {
                                vm.clearCart()
                                customerName = ""
                                notes = ""
                                // [BARU] Munculkan dialog pesanan diproses
                                showProcessedDialog = true
                                "Pesanan berhasil dicatat! Terima kasih ♡"
                            }
                        }
                    },
                    modifier = Modifier.fillMaxWidth(),
                    colors = ButtonDefaults.buttonColors(
                        containerColor = Orange
                    ),
                    shape = RoundedCornerShape(12.dp)
                ) {
                    Text("Kirim pesanan →")
                }

                if (message.isNotEmpty()) {
                    Text(
                        message,
                        modifier = Modifier.padding(vertical = 8.dp),
                        color = Green,
                        fontSize = 13.sp
                    )
                }

                Text(
                    "Pesanan dicatat. Kafe akan mengonfirmasi ketersediaan dan pengambilan secara terpisah.",
                    color = Muted,
                    fontSize = 11.sp
                )

                Spacer(Modifier.height(20.dp))
            }
        }
    }

    // [BARU] Tampilkan dialog di tengah layar
    if (showProcessedDialog) {
        OrderProcessedDialog(
            onDismiss = { showProcessedDialog = false }
        )
    }
}

// BARIS RINGKASAN HARGA
@Composable
fun PriceRow(
    label: String,
    value: String,
    bold: Boolean = false
) {
    Row(
        modifier = Modifier
            .fillMaxWidth()
            .padding(vertical = 5.dp),
        horizontalArrangement = Arrangement.SpaceBetween
    ) {
        Text(
            label,
            color = if (bold) Green else Brown,
            fontWeight = if (bold) FontWeight.Bold else FontWeight.Normal
        )

        Text(
            value,
            color = if (bold) Green else Brown,
            fontWeight = FontWeight.Bold
        )
    }
}

// [BARU] DIALOG PESANAN DIPROSES
@Composable
fun OrderProcessedDialog(
    onDismiss: () -> Unit
) {
    Dialog(
        onDismissRequest = onDismiss,
        properties = DialogProperties(
            dismissOnBackPress = true,
            dismissOnClickOutside = false
        )
    ) {
        Column(
            modifier = Modifier
                .fillMaxWidth()
                .background(Color.White, RoundedCornerShape(20.dp)),
            horizontalAlignment = Alignment.CenterHorizontally
        ) {

            // Header berwarna
            Box(
                modifier = Modifier
                    .fillMaxWidth()
                    .background(
                        Green,
                        RoundedCornerShape(topStart = 20.dp, topEnd = 20.dp)
                    )
                    .padding(vertical = 14.dp),
                contentAlignment = Alignment.Center
            ) {
                Text(
                    "Terima kasih ♡",
                    color = Color.White,
                    fontSize = 17.sp,
                    fontWeight = FontWeight.Bold
                )
            }

            Spacer(Modifier.height(24.dp))

            // Ikon centang
            Box(
                modifier = Modifier
                    .size(72.dp)
                    .background(Sage, CircleShape),
                contentAlignment = Alignment.Center
            ) {
                Box(
                    modifier = Modifier
                        .size(48.dp)
                        .background(Green, CircleShape),
                    contentAlignment = Alignment.Center
                ) {
                    Text(
                        "✓",
                        color = Color.White,
                        fontSize = 28.sp,
                        fontWeight = FontWeight.Bold
                    )
                }
            }

            Spacer(Modifier.height(16.dp))

            Text(
                "Pesanan sudah di proses",
                color = Brown,
                fontSize = 18.sp,
                fontWeight = FontWeight.Bold,
                textAlign = TextAlign.Center,
                modifier = Modifier.padding(horizontal = 20.dp)
            )

            Spacer(Modifier.height(6.dp))

            Text(
                "Kafe akan mengonfirmasi ketersediaan dan pengambilan secara terpisah.",
                color = Muted,
                fontSize = 12.sp,
                textAlign = TextAlign.Center,
                modifier = Modifier.padding(horizontal = 24.dp)
            )

            Spacer(Modifier.height(22.dp))

            Button(
                onClick = onDismiss,
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(horizontal = 20.dp),
                colors = ButtonDefaults.buttonColors(
                    containerColor = Orange
                ),
                shape = RoundedCornerShape(12.dp)
            ) {
                Text("OK")
            }

            Spacer(Modifier.height(20.dp))
        }
    }
